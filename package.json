{
  "name": "thepplbot",
  "version": "0.1.3",
  "description": "Embeddable AI tutor widget — iOS-style, customizable colors, logo, and curriculum. Powered by Claude.",
  "keywords": [
    "ai",
    "tutor",
    "assistant",
    "widget",
    "chat",
    "claude",
    "anthropic",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/firme-coding/thepplbot"
  },
  "homepage": "https://github.com/firme-coding/thepplbot#readme",
  "type": "module",
  "main": "dist/thepplbot.cjs",
  "module": "dist/thepplbot.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/thepplbot.js",
      "require": "./dist/thepplbot.cjs",
      "types": "./dist/index.d.ts"
    },
    "./curriculum-french-quarter": {
      "import": "./dist/curriculum-french-quarter.js",
      "require": "./dist/curriculum-french-quarter.cjs",
      "types": "./dist/curriculum-french-quarter.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "GETTING_STARTED.md",
    "CUSTOMIZATION.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run build && node dev/smoke-test.mjs",
    "yalc:push": "npm run build && yalc push",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vite-plugin-dts": "^3.9.0"
  }
}
